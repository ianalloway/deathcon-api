# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Set two distinct random values before starting the service.
DEATHCON_OPERATOR_TOKEN=
DEATHCON_WEBHOOK_TOKEN=

# CORS Configuration (comma-separated for multiple origins, or "*" for all)
CORS_ORIGINS=*

# Allow credentials in CORS requests (true/false)
CORS_ALLOW_CREDENTIALS=false
